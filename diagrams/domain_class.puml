@startuml domain_class

skinparam classAttributeIconSize 0
hide circle

' ============================================================
' HRS 概念クラス図（実装 src/web/app.js に整合させた版）
' 変更点の一覧は diagram_changes.md を参照
' ============================================================

class 利用者 {
  利用者ID : String
  氏名 : String
  電話番号 : String
  メールアドレス : String
}

class アカウント {
  アカウントID : String
  メールアドレス : String
  パスワード : String
  登録日時 : DateTime
}

class 予約システム管理者 {
  管理者ID : String
}

class フロントスタッフ {
  スタッフID : String
}

class ホテル {
  ホテルID : String
  ホテル名 : String
  地方 : String
  都道府県 : String
  市区町村 : String
  住所 : String
  説明 : String
}

class 部屋種別 {
  種別ID : String
  種別名 : String
  定員 : int
  一泊料金 : int
}

class 部屋 {
  部屋ID : String
  部屋番号 : String
  状態 : RoomStatus
}

class 予約 {
  予約番号 : String
  チェックイン日 : Date
  チェックアウト日 : Date
  人数 : int
  状態 : ReservationStatus
  基本料金 : int
  支払済 : boolean
  予約日時 : DateTime
  キャンセル日時 : DateTime [0..1]
  チェックイン日時 : DateTime [0..1]
  チェックアウト日時 : DateTime [0..1]
}

class 宿泊 {
  宿泊ID : String
  実チェックイン日時 : DateTime
  実チェックアウト日時 : DateTime [0..1]
}

class 追加料金 {
  追加料金ID : String
  名目 : String
  金額 : int
}

class 請求 {
  請求番号 : String
  基本料金 : int
  追加料金合計 : int
  合計金額 : int
  発行日時 : DateTime
}

class 支払い {
  支払番号 : String
  支払種別 : String
  金額 : int
  支払方法 : String
  支払日時 : DateTime
}

enum ReservationStatus {
  RESERVED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  OUT_OF_SERVICE
}

' ============================================================
' 関係と多重度（概念レベルなので向きは付けない）
' ============================================================
利用者              "1"    --  "1"    アカウント
ホテル              "1"    o-- "*"    部屋
ホテル              "1"    o-- "*"    部屋種別
部屋種別            "1"    --  "*"    部屋
利用者              "1"    --  "*"    予約
予約                "*"    --  "1"    ホテル
予約                "*"    --  "1"    部屋種別
予約                "*"    --  "0..1" 部屋 : 割当
予約                "1"    --  "0..1" 宿泊
予約                "1"    --  "*"    追加料金
予約                "1"    --  "0..1" 請求
予約                "1"    --  "0..1" 支払い
宿泊                "*"    --  "1"    部屋
予約システム管理者  "*"    --  "*"    ホテル : 管理
フロントスタッフ    "1"    --  "1"    ホテル : 担当

note bottom of 請求
  請求と支払いはチェックアウト時に
  同時に作成される（実装仕様）。
  合計金額 = 基本料金 + 追加料金合計
  = 支払い.金額
end note

note bottom of 予約
  基本料金は予約確定時の
  一泊料金 × 泊数 を保存する。
  後から料金表を変えても
  既存予約の金額は変わらない。
end note

@enduml
